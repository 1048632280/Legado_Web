import { Button, LineEdit, ScrollView, TextEdit } from "std-widgets.slint";

export struct BookItem {
    id: string,
    title: string,
    author: string,
    chapters: int,
    progress: string,
}

export struct ChapterItem {
    index: int,
    title: string,
}

export struct FilterItem {
    id: int,
    search: string,
    replacement: string,
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> hint;
    callback clicked();
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: touch.pressed ? #e8edf5 : (touch.has-hover ? #eef2f7 : transparent);
    Text { text: icon; color: #536174; font-size: 17px; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component MainWindow inherits Window {
    title: "Legado Next";
    min-width: 980px;
    min-height: 640px;
    width: 1240px;
    height: 800px;
    background: #f5f7fa;

    in property <int> page: 0;
    in property <bool> catalog-open: false;
    in property <string> selected-book-title: "书架";
    in property <string> selected-book-author: "";
    in property <string> recent-book-title: "";
    in property <string> recent-book-id: "";
    in property <string> selected-chapter-title: "";
    in property <string> chapter-content: "";
    in property <string> status: "";
    in property <string> search-text: "";
    in property <string> filter-search: "";
    in property <string> filter-replacement: "";
    in property <int> theme: 0;
    in property <int> font: 4;
    in property <int> font-size: 18;
    in property <float> line-spacing: 0.8;
    in property <float> paragraph-spacing: 1.0;
    in property <float> letter-spacing-value: 0.0;
    in property <int> jump-duration: 1000;
    in property <bool> infinite-loading: false;
    in property <int> read-width: 800;
    in property <bool> settings-open: false;
    in property <bool> filters-open: false;
    in property <bool> sidebar-open: true;
    in property <[BookItem]> books;
    in property <[ChapterItem]> chapters;
    in property <[FilterItem]> filters;

    callback import-clicked();
    callback files-dropped([string]);
    callback clear-clicked();
    callback search-changed(string);
    callback book-clicked(string);
    callback book-delete(string);
    callback shelf-clicked();
    callback recent-clicked(string);
    callback chapter-clicked(int);
    callback previous-clicked();
    callback next-clicked();
    callback settings-clicked();
    callback filters-clicked();
    callback close-panel();
    callback add-filter(string, string);
    callback remove-filter(int);
    callback save-settings(int, int, int, float, float, int);
    callback save-advanced-settings(float, int, bool);

    Rectangle {
        background: #f5f7fa;
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: sidebar-open ? 248px : 68px;
                background: #182230;
                animate width { duration: 160ms; }
                VerticalLayout {
                    padding: 22px 14px;
                    spacing: 20px;
                    Rectangle { height: 32px; HorizontalLayout { spacing: 10px; Text { text: "◈"; color: #74a7ff; font-size: 23px; } if sidebar-open: Text { text: "LEGADO NEXT"; color: #f4f7fb; font-size: 16px; font-weight: 700; vertical-alignment: center; } } }
                    Rectangle { height: 1px; background: #2c3949; }
                    Rectangle {
                        height: 42px; border-radius: 9px; background: page == 0 ? #2c5d9e : transparent;
                        HorizontalLayout { padding: 0 12px; spacing: 12px; Text { text: "▦"; color: #dce9fb; font-size: 18px; vertical-alignment: center; } if sidebar-open: Text { text: "我的书架"; color: #f3f7ff; font-size: 14px; vertical-alignment: center; } }
                        TouchArea { clicked => { shelf-clicked(); } }
                    }
                    if recent-book-title != "": Rectangle {
                        height: 58px; border-radius: 9px; background: #202d3d;
                        VerticalLayout { padding: 8px 12px; spacing: 3px; Text { text: "最近阅读"; color: #8fa5c2; font-size: 10px; } Text { text: recent-book-title; color: #f3f7ff; font-size: 12px; overflow: elide; } }
                        TouchArea { clicked => { recent-clicked(recent-book-id); } }
                    }
                    Rectangle { vertical-stretch: 1; }
                    if sidebar-open: Text { text: "纯本地 · 无网络 · SQLite"; color: #8190a5; font-size: 11px; horizontal-alignment: center; }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                VerticalLayout {
                    Rectangle {
                        height: 66px; background: #ffffff; border-bottom-width: 1px; border-color: #e5e9ef;
                        HorizontalLayout { padding: 0 26px; spacing: 14px;
                            IconButton { icon: sidebar-open ? "‹" : "›"; clicked => { sidebar-open = !sidebar-open; } }
                            Text { text: page == 0 ? "书架" : selected-book-title; color: #1c2734; font-size: 20px; font-weight: 700; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            if page == 0: LineEdit { width: 220px; height: 34px; text: search-text; placeholder-text: "筛选书架"; edited(text) => { search-changed(text); } }
                            if page == 1: IconButton { icon: "☷"; hint: "目录"; clicked => { catalog-open = !catalog-open; filters-open = false; settings-open = false; } }
                            if page == 1: IconButton { icon: "Aa"; hint: "阅读设置"; clicked => { settings-clicked(); } }
                            if page == 1: IconButton { icon: "⌁"; hint: "内容过滤"; clicked => { filters-clicked(); } }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; vertical-stretch: 1;
                        if page == 0: Rectangle {
                            background: #f5f7fa;
                            drop := DropArea {
                                dropped(files) => { files-dropped(files); }
                            }
                            VerticalLayout { padding: 28px; spacing: 18px;
                                HorizontalLayout { height: 54px; Text { text: "本地书架"; color: #1c2734; font-size: 28px; font-weight: 700; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } Button { text: "清空数据"; clicked => { clear-clicked(); } } Button { text: "+  导入 TXT"; clicked => { import-clicked(); } } }
                                if books.length == 0: Rectangle { vertical-stretch: 1; border-radius: 14px; background: #ffffff; border-width: 1px; border-color: #e4e9f0; VerticalLayout { alignment: center; spacing: 12px; Text { text: "还没有书籍"; color: #253246; font-size: 22px; font-weight: 600; horizontal-alignment: center; } Text { text: "导入本地 TXT 文件，开始你的阅读。"; color: #7e8b9c; font-size: 14px; horizontal-alignment: center; } Button { text: "选择 TXT 文件"; clicked => { import-clicked(); } } } }
                                if books.length > 0: ScrollView { vertical-stretch: 1; ListView { for book in books: Rectangle { height: 96px; width: parent.width; border-radius: 12px; background: touch.pressed ? #eaf1ff : (touch.has-hover ? #fbfcfe : #ffffff); border-width: 1px; border-color: #e2e8f0; HorizontalLayout { padding: 16px; spacing: 16px; Rectangle { width: 46px; height: 62px; border-radius: 7px; background: #dbe8fb; Text { text: "TXT"; color: #3c6ca9; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } } VerticalLayout { spacing: 5px; Text { text: book.title; color: #202d3d; font-size: 16px; font-weight: 600; } Text { text: book.author + "  ·  " + book.chapters + " 章"; color: #8a96a5; font-size: 12px; } Text { text: book.progress; color: #5c83b6; font-size: 12px; } } Rectangle { horizontal-stretch: 1; } IconButton { icon: "⋯"; clicked => { book-delete(book.id); } } } TouchArea { clicked => { book-clicked(book.id); } } } } }
                            }
                        }
                        if page == 1: Rectangle {
                            background: theme == 6 ? #202124 : (theme == 4 ? #fff3f3 : #fbfaf7);
                            ScrollView { HorizontalLayout { alignment: center; Rectangle { width: read-width; min-width: 620px; max-width: 1100px; padding: 50px 70px; VerticalLayout { spacing: 20px; Text { text: selected-chapter-title; color: theme == 6 ? #f1f3f4 : #26323f; font-size: font-size + 5px; font-weight: 700; } Text { text: selected-book-author; color: theme == 6 ? #9aa0a6 : #8b7d72; font-size: 12px; } Text { text: chapter-content; color: theme == 6 ? #e8eaed : #3b3a38; font-family: font == 0 ? "SimSun" : (font == 1 ? "SimHei" : (font == 2 ? "KaiTi" : (font == 3 ? "PingFang SC" : "Microsoft YaHei"))); font-size: font-size; line-height: 1.0 + line-spacing; letter-spacing: 0px; wrap: word-wrap; } } } }
                            Rectangle { x: 0px; y: parent.height - 62px; height: 62px; width: parent.width; background: #ffffffdd; border-top-width: 1px; border-color: #e7ebef; HorizontalLayout { padding: 0 28px; spacing: 10px; Button { text: "‹ 上一章"; clicked => { previous-clicked(); } } Rectangle { horizontal-stretch: 1; } Text { text: status; color: #8a96a5; font-size: 12px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } Button { text: "下一章 ›"; clicked => { next-clicked(); } } } }
                        }
                        if catalog-open: Rectangle { x: 0px; y: 0px; width: 320px; height: parent.height - 62px; background: #ffffff; border-right-width: 1px; border-color: #e0e6ee; VerticalLayout { padding: 20px; spacing: 10px; Text { text: "章节目录"; color: #253246; font-size: 17px; font-weight: 700; } ScrollView { vertical-stretch: 1; ListView { for chapter in chapters: Rectangle { height: 38px; width: parent.width; Text { text: chapter.title; color: #586679; font-size: 13px; vertical-alignment: center; overflow: elide; } TouchArea { clicked => { chapter-clicked(chapter.index); catalog-open = false; } } } } } Button { text: "关闭目录"; clicked => { catalog-open = false; } } } }
                    }
                }
            }
        }
    }

    if settings-open: Rectangle { x: parent.width - 360px; y: 66px; width: 340px; height: 510px; background: #ffffff; border-width: 1px; border-color: #dfe5ed; border-radius: 12px; VerticalLayout { padding: 24px; spacing: 14px; Text { text: "阅读设置"; color: #1f2b3a; font-size: 18px; font-weight: 700; } Text { text: "主题"; color: #7b8796; font-size: 12px; } HorizontalLayout { spacing: 7px; Rectangle { width: 34px; height: 28px; border-radius: 6px; background: #f1ede4; border-width: theme == 0 ? 2px : 0px; border-color: #4f82c2; TouchArea { clicked => { save-settings(0, font-size, read-width, line-spacing, paragraph-spacing, font); } } } Rectangle { width: 34px; height: 28px; border-radius: 6px; background: #f1ede4; border-width: theme == 1 ? 2px : 0px; border-color: #4f82c2; TouchArea { clicked => { save-settings(1, font-size, read-width, line-spacing, paragraph-spacing, font); } } } Rectangle { width: 34px; height: 28px; border-radius: 6px; background: #e5f2e7; border-width: theme == 2 ? 2px : 0px; border-color: #4f82c2; TouchArea { clicked => { save-settings(2, font-size, read-width, line-spacing, paragraph-spacing, font); } } } Rectangle { width: 34px; height: 28px; border-radius: 6px; background: #f1ede4; border-width: theme == 3 ? 2px : 0px; border-color: #4f82c2; TouchArea { clicked => { save-settings(3, font-size, read-width, line-spacing, paragraph-spacing, font); } } } Rectangle { width: 34px; height: 28px; border-radius: 6px; background: #ffe4e4; border-width: theme == 4 ? 2px : 0px; border-color: #4f82c2; TouchArea { clicked => { save-settings(4, font-size, read-width, line-spacing, paragraph-spacing, font); } } } Rectangle { width: 34px; height: 28px; border-radius: 6px; background: #dfe3e8; border-width: theme == 5 ? 2px : 0px; border-color: #4f82c2; TouchArea { clicked => { save-settings(5, font-size, read-width, line-spacing, paragraph-spacing, font); } } } Rectangle { width: 34px; height: 28px; border-radius: 6px; background: #202124; border-width: theme == 6 ? 2px : 0px; border-color: #4f82c2; TouchArea { clicked => { save-settings(6, font-size, read-width, line-spacing, paragraph-spacing, font); } } } } }
                        Text { text: "字体大小"; color: #7b8796; font-size: 12px; } HorizontalLayout { spacing: 8px; Button { text: "−"; clicked => { save-settings(theme, font-size - 2, read-width, line-spacing, paragraph-spacing, font); } } Text { text: font-size + " px"; horizontal-alignment: center; vertical-alignment: center; } Button { text: "+"; clicked => { save-settings(theme, font-size + 2, read-width, line-spacing, paragraph-spacing, font); } } }
                        Text { text: "行距与段距"; color: #7b8796; font-size: 12px; } HorizontalLayout { spacing: 8px; Button { text: "−"; clicked => { save-settings(theme, font-size, read-width, line-spacing - 0.1, paragraph-spacing - 0.1, font); } } Text { text: line-spacing; horizontal-alignment: center; vertical-alignment: center; } Button { text: "+"; clicked => { save-settings(theme, font-size, read-width, line-spacing + 0.1, paragraph-spacing + 0.1, font); } } }
                        Text { text: "正文宽度"; color: #7b8796; font-size: 12px; } HorizontalLayout { spacing: 8px; Button { text: "−"; clicked => { save-settings(theme, font-size, read-width - 80, line-spacing, paragraph-spacing, font); } } Text { text: read-width + " px"; horizontal-alignment: center; vertical-alignment: center; } Button { text: "+"; clicked => { save-settings(theme, font-size, read-width + 80, line-spacing, paragraph-spacing, font); } } }
                        Text { text: "字距"; color: #7b8796; font-size: 12px; } HorizontalLayout { spacing: 8px; Button { text: "−"; clicked => { save-advanced-settings(letter-spacing-value - 0.01, jump-duration, infinite-loading); } } Text { text: letter-spacing-value; horizontal-alignment: center; vertical-alignment: center; } Button { text: "+"; clicked => { save-advanced-settings(letter-spacing-value + 0.01, jump-duration, infinite-loading); } } }
                        Text { text: "翻页速度"; color: #7b8796; font-size: 12px; } HorizontalLayout { spacing: 8px; Button { text: "−"; clicked => { save-advanced-settings(letter-spacing-value, jump-duration - 100, infinite-loading); } } Text { text: jump-duration + " ms"; horizontal-alignment: center; vertical-alignment: center; } Button { text: "+"; clicked => { save-advanced-settings(letter-spacing-value, jump-duration + 100, infinite-loading); } } }
                        Text { text: "无限加载"; color: #7b8796; font-size: 12px; } HorizontalLayout { spacing: 8px; Button { text: infinite-loading ? "关闭" : "开启"; clicked => { save-advanced-settings(letter-spacing-value, jump-duration, !infinite-loading); } } }
                        Text { text: "字体"; color: #7b8796; font-size: 12px; } HorizontalLayout { spacing: 5px; Button { text: "宋"; clicked => { save-settings(theme, font-size, read-width, line-spacing, paragraph-spacing, 0); } } Button { text: "黑"; clicked => { save-settings(theme, font-size, read-width, line-spacing, paragraph-spacing, 1); } } Button { text: "楷"; clicked => { save-settings(theme, font-size, read-width, line-spacing, paragraph-spacing, 2); } } Button { text: "苹"; clicked => { save-settings(theme, font-size, read-width, line-spacing, paragraph-spacing, 3); } } Button { text: "雅黑"; clicked => { save-settings(theme, font-size, read-width, line-spacing, paragraph-spacing, 4); } } }
                        Rectangle { vertical-stretch: 1; } Button { text: "关闭"; clicked => { close-panel(); } }
                    } }
    if filters-open: Rectangle { x: parent.width - 410px; y: 66px; width: 390px; height: 560px; background: #ffffff; border-width: 1px; border-color: #dfe5ed; border-radius: 12px; VerticalLayout { padding: 24px; spacing: 12px; Text { text: "内容过滤"; color: #1f2b3a; font-size: 18px; font-weight: 700; } Text { text: "阅读时自动替换或删除匹配内容"; color: #8994a3; font-size: 12px; } TextEdit { height: 72px; text: filter-search; placeholder-text: "过滤内容"; edited(text) => { filter-search = text; } } TextEdit { height: 72px; text: filter-replacement; placeholder-text: "替换内容（留空表示删除）"; edited(text) => { filter-replacement = text; } } Button { text: "+  添加规则"; clicked => { add-filter(filter-search, filter-replacement); } } Text { text: "已有规则"; color: #7b8796; font-size: 12px; } ScrollView { vertical-stretch: 1; ListView { for rule in filters: Rectangle { height: 58px; border-bottom-width: 1px; border-color: #edf0f4; HorizontalLayout { padding: 8px 0; spacing: 8px; VerticalLayout { horizontal-stretch: 1; Text { text: rule.search; color: #2d3948; font-size: 12px; } Text { text: rule.replacement == "" ? "删除" : "→ " + rule.replacement; color: #8994a3; font-size: 11px; } } Button { text: "删除"; clicked => { remove-filter(rule.id); } } } } } } Button { text: "关闭"; clicked => { close-panel(); } } } }
}
