import { Button, LineEdit, ListView, ScrollView, TextEdit } from "std-widgets.slint";

export struct BookItem {
    id: string,
    title: string,
    author: string,
    chapters: int,
    progress: string,
    index: int,
}

export struct ChapterItem { index: int, title: string }
export struct FilterItem { id: int, search: string, replacement: string }

export global Theme {
    out property <color> accent: #ed4259;
    out property <color> shell-background: #f5f6f8;
    out property <color> sidebar-background: #f8f8f7;
    out property <color> surface: #ffffff;
    out property <color> border: #e4e5e7;
    out property <color> text: #34383e;
    out property <color> muted: #737982;
}

component Stepper inherits Rectangle {
    in property <string> value;
    callback decrement();
    callback increment();
    width: 152px;
    height: 34px;
    border-width: 1px;
    border-color: #d9d3c9;
    border-radius: 4px;
    background: #ffffff;
    HorizontalLayout {
        spacing: 0px;
        Rectangle { width: 34px; background: minus-touch.pressed ? #f6e8e8 : #faf8f4; Text { text: "-"; color: #4b4641; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; } minus-touch := TouchArea { clicked => { root.decrement(); } } }
        Rectangle { width: 1px; background: #e6e1d9; }
        Text { text: root.value; horizontal-stretch: 1; color: #34312d; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
        Rectangle { width: 1px; background: #e6e1d9; }
        Rectangle { width: 34px; background: plus-touch.pressed ? #f6e8e8 : #faf8f4; Text { text: "+"; color: #4b4641; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; } plus-touch := TouchArea { clicked => { root.increment(); } } }
    }
}

component ReaderTool inherits Rectangle {
    in property <string> label;
    in property <bool> dark;
    in property <image> icon;
    callback clicked();
    width: 58px;
    height: 54px;
    border-width: 1px;
    border-color: root.dark ? #444444 : #ded9d2;
    background: tool-touch.pressed ? (root.dark ? #393939 : #f4e6e6) : (root.dark ? #2b2b2b : #faf7f2);
    VerticalLayout { alignment: center; spacing: 2px; Image { source: root.icon; width: 16px; height: 16px; colorize: root.dark ? #dddddd : #333333; } Text { text: root.label; color: root.dark ? #dddddd : #333333; font-size: 11px; horizontal-alignment: center; } }
    tool-touch := TouchArea { clicked => { root.clicked(); } }
}

component BookCard inherits Rectangle {
    in property <BookItem> book;
    callback open(string);
    callback remove(string);
    height: 144px;
    border-width: 1px;
    border-color: card-touch.has-hover ? #bfd5ec : Theme.border;
    border-radius: 8px;
    background: card-touch.pressed ? #f5f9fd : Theme.surface;
    card-touch := TouchArea { clicked => { root.open(root.book.id); } }
    HorizontalLayout {
        padding: 16px;
        spacing: 16px;
        Rectangle { width: 80px; height: 112px; border-radius: 5px; background: #d9b991; VerticalLayout { padding: 8px; alignment: center; spacing: 5px; Rectangle { vertical-stretch: 1; } Text { text: "本地藏书"; color: #fffaf1; font-size: 10px; horizontal-alignment: center; } Text { text: root.book.title; color: #fffaf1; font-size: 12px; font-weight: 600; horizontal-alignment: center; overflow: elide; } Rectangle { vertical-stretch: 1; } } }
        VerticalLayout { horizontal-stretch: 1; spacing: 6px; Text { text: root.book.title; color: Theme.text; font-size: 16px; font-weight: 700; overflow: elide; } Text { text: root.book.author + "  ·  共 " + root.book.chapters + " 章"; color: Theme.muted; font-size: 12px; overflow: elide; } Text { text: "已读：" + root.book.progress; color: Theme.muted; font-size: 12px; overflow: elide; } Rectangle { vertical-stretch: 1; } Button { text: "删除"; width: 52px; height: 28px; clicked => { root.remove(root.book.id); } } }
    }
}

component CatalogPanel inherits Rectangle {
    in property <bool> dark;
    in property <[ChapterItem]> chapters;
    callback chapter-clicked(int);
    callback close();
    background: root.dark ? #252525 : #ede7da;
    border-width: 1px;
    border-color: root.dark ? #555555 : #d8d8d8;
    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        Text { text: "目录"; color: Theme.accent; font-size: 18px; }
        Rectangle { height: 1px; background: root.dark ? #4a4a4a : #ddd6cc; }
        ListView { vertical-stretch: 1; for chapter in root.chapters: Rectangle { height: 40px; background: catalog-touch.pressed ? (root.dark ? #333333 : #e7e0d5) : transparent; VerticalLayout { padding-left: 4px; Text { text: chapter.title; color: root.dark ? #dddddd : #333333; font-size: 14px; vertical-alignment: center; overflow: elide; } } catalog-touch := TouchArea { clicked => { root.chapter-clicked(chapter.index); } } } }
        Button { text: "关闭"; clicked => { root.close(); } }
    }
}

component SettingsPanel inherits Rectangle {
    in property <bool> dark;
    in property <int> theme;
    in property <int> font;
    in property <int> font-size;
    in property <float> line-spacing;
    in property <float> paragraph-spacing;
    in property <float> letter-spacing-value;
    in property <int> jump-duration;
    in property <bool> infinite-loading;
    in property <int> read-width;
    callback save-settings(int, int, int, float, float, int);
    callback save-advanced-settings(float, int, bool);
    callback close();
    background: root.dark ? #2c2c2c : #faeceb;
    border-width: 1px;
    border-color: root.dark ? #555555 : #dfd4cf;
    VerticalLayout {
        padding: 24px;
        spacing: 10px;
        Text { text: "设置"; color: Theme.accent; font-size: 18px; }
        Rectangle { height: 1px; background: root.dark ? #555555 : #e2d9d4; }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 10px;
                HorizontalLayout { height: 34px; Text { text: "阅读主题"; width: 80px; color: root.dark ? #dddddd : #333333; font-size: 12px; vertical-alignment: center; } HorizontalLayout { spacing: 8px; Rectangle { width: 24px; height: 24px; border-radius: 12px; background: #faf5eb; border-width: root.theme == 0 ? 2px : 1px; border-color: root.theme == 0 ? Theme.accent : #c9c2b8; TouchArea { clicked => { root.save-settings(0, root.font-size, root.read-width, root.line-spacing, root.paragraph-spacing, root.font); } } } Rectangle { width: 24px; height: 24px; border-radius: 12px; background: #f5eacc; border-width: root.theme == 1 ? 2px : 1px; border-color: root.theme == 1 ? Theme.accent : #c9c2b8; TouchArea { clicked => { root.save-settings(1, root.font-size, root.read-width, root.line-spacing, root.paragraph-spacing, root.font); } } } Rectangle { width: 24px; height: 24px; border-radius: 12px; background: #e6f2e6; border-width: root.theme == 2 ? 2px : 1px; border-color: root.theme == 2 ? Theme.accent : #c9c2b8; TouchArea { clicked => { root.save-settings(2, root.font-size, root.read-width, root.line-spacing, root.paragraph-spacing, root.font); } } } Rectangle { width: 24px; height: 24px; border-radius: 12px; background: #e4f1f5; border-width: root.theme == 3 ? 2px : 1px; border-color: root.theme == 3 ? Theme.accent : #c9c2b8; TouchArea { clicked => { root.save-settings(3, root.font-size, root.read-width, root.line-spacing, root.paragraph-spacing, root.font); } } } Rectangle { width: 24px; height: 24px; border-radius: 12px; background: #f5e4e4; border-width: root.theme == 4 ? 2px : 1px; border-color: root.theme == 4 ? Theme.accent : #c9c2b8; TouchArea { clicked => { root.save-settings(4, root.font-size, root.read-width, root.line-spacing, root.paragraph-spacing, root.font); } } } Rectangle { width: 24px; height: 24px; border-radius: 12px; background: #e0e0e0; border-width: root.theme == 5 ? 2px : 1px; border-color: root.theme == 5 ? Theme.accent : #c9c2b8; TouchArea { clicked => { root.save-settings(5, root.font-size, root.read-width, root.line-spacing, root.paragraph-spacing, root.font); } } } Rectangle { width: 24px; height: 24px; border-radius: 12px; background: #222222; border-width: root.theme == 6 ? 2px : 1px; border-color: root.theme == 6 ? Theme.accent : #c9c2b8; TouchArea { clicked => { root.save-settings(6, root.font-size, root.read-width, root.line-spacing, root.paragraph-spacing, root.font); } } } } }
                HorizontalLayout { height: 38px; Text { text: "正文字体"; width: 80px; color: root.dark ? #dddddd : #333333; font-size: 12px; vertical-alignment: center; } HorizontalLayout { spacing: 3px; Button { text: "宋体"; width: 48px; height: 30px; clicked => { root.save-settings(root.theme, root.font-size, root.read-width, root.line-spacing, root.paragraph-spacing, 0); } } Button { text: "黑体"; width: 48px; height: 30px; clicked => { root.save-settings(root.theme, root.font-size, root.read-width, root.line-spacing, root.paragraph-spacing, 1); } } Button { text: "楷体"; width: 48px; height: 30px; clicked => { root.save-settings(root.theme, root.font-size, root.read-width, root.line-spacing, root.paragraph-spacing, 2); } } Button { text: "苹方"; width: 48px; height: 30px; clicked => { root.save-settings(root.theme, root.font-size, root.read-width, root.line-spacing, root.paragraph-spacing, 3); } } Button { text: "雅黑"; width: 48px; height: 30px; clicked => { root.save-settings(root.theme, root.font-size, root.read-width, root.line-spacing, root.paragraph-spacing, 4); } } } }
                HorizontalLayout { height: 34px; Text { text: "字体大小"; width: 80px; color: root.dark ? #dddddd : #333333; font-size: 12px; vertical-alignment: center; } Stepper { value: root.font-size + " px"; decrement => { root.save-settings(root.theme, root.font-size - 2, root.read-width, root.line-spacing, root.paragraph-spacing, root.font); } increment => { root.save-settings(root.theme, root.font-size + 2, root.read-width, root.line-spacing, root.paragraph-spacing, root.font); } } }
                HorizontalLayout { height: 34px; Text { text: "字距"; width: 80px; color: root.dark ? #dddddd : #333333; font-size: 12px; vertical-alignment: center; } Stepper { value: root.letter-spacing-value + ""; decrement => { root.save-advanced-settings(root.letter-spacing-value - 0.01, root.jump-duration, root.infinite-loading); } increment => { root.save-advanced-settings(root.letter-spacing-value + 0.01, root.jump-duration, root.infinite-loading); } } }
                HorizontalLayout { height: 34px; Text { text: "行距"; width: 80px; color: root.dark ? #dddddd : #333333; font-size: 12px; vertical-alignment: center; } Stepper { value: root.line-spacing + ""; decrement => { root.save-settings(root.theme, root.font-size, root.read-width, root.line-spacing - 0.1, root.paragraph-spacing, root.font); } increment => { root.save-settings(root.theme, root.font-size, root.read-width, root.line-spacing + 0.1, root.paragraph-spacing, root.font); } } }
                HorizontalLayout { height: 34px; Text { text: "段距"; width: 80px; color: root.dark ? #dddddd : #333333; font-size: 12px; vertical-alignment: center; } Stepper { value: root.paragraph-spacing + ""; decrement => { root.save-settings(root.theme, root.font-size, root.read-width, root.line-spacing, root.paragraph-spacing - 0.1, root.font); } increment => { root.save-settings(root.theme, root.font-size, root.read-width, root.line-spacing, root.paragraph-spacing + 0.1, root.font); } } }
                HorizontalLayout { height: 34px; Text { text: "页面宽度"; width: 80px; color: root.dark ? #dddddd : #333333; font-size: 12px; vertical-alignment: center; } Stepper { value: root.read-width + " px"; decrement => { root.save-settings(root.theme, root.font-size, root.read-width - 160, root.line-spacing, root.paragraph-spacing, root.font); } increment => { root.save-settings(root.theme, root.font-size, root.read-width + 160, root.line-spacing, root.paragraph-spacing, root.font); } } }
                HorizontalLayout { height: 34px; Text { text: "翻页速度"; width: 80px; color: root.dark ? #dddddd : #333333; font-size: 12px; vertical-alignment: center; } Stepper { value: root.jump-duration + " ms"; decrement => { root.save-advanced-settings(root.letter-spacing-value, root.jump-duration - 100, root.infinite-loading); } increment => { root.save-advanced-settings(root.letter-spacing-value, root.jump-duration + 100, root.infinite-loading); } } }
                HorizontalLayout { height: 34px; Text { text: "无限加载"; width: 80px; color: root.dark ? #dddddd : #333333; font-size: 12px; vertical-alignment: center; } Button { text: root.infinite-loading ? "开启" : "关闭"; width: 84px; clicked => { root.save-advanced-settings(root.letter-spacing-value, root.jump-duration, !root.infinite-loading); } } }
            }
        }
        Button { text: "关闭"; width: 84px; clicked => { root.close(); } }
    }
}

component FilterPanel inherits Rectangle {
    in property <bool> dark;
    in-out property <string> search;
    in-out property <string> replacement;
    in property <[FilterItem]> filters;
    callback add-filter(string, string);
    callback remove-filter(int);
    callback close();
    background: root.dark ? #2c2c2c : #faeceb;
    border-width: 1px;
    border-color: root.dark ? #555555 : #dfd4cf;
    VerticalLayout {
        padding: 24px;
        spacing: 10px;
        Text { text: "内容过滤"; color: Theme.accent; font-size: 18px; }
        Rectangle { height: 1px; background: root.dark ? #555555 : #e2d9d4; }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 10px;
                Text { text: "过滤内容"; color: root.dark ? #dddddd : #333333; font-size: 12px; }
                TextEdit { height: 72px; text: root.search; placeholder-text: "输入要过滤的内容"; edited(text) => { root.search = text; } }
                Text { text: "替换内容"; color: root.dark ? #dddddd : #333333; font-size: 12px; }
                TextEdit { height: 72px; text: root.replacement; placeholder-text: "留空表示直接删除"; edited(text) => { root.replacement = text; } }
                HorizontalLayout { Text { text: "留空替换内容可直接删除匹配文本"; horizontal-stretch: 1; color: root.dark ? #aaaaaa : #777777; font-size: 11px; vertical-alignment: center; } Button { text: "添加规则"; clicked => { root.add-filter(root.search, root.replacement); } } }
                Rectangle { height: 1px; background: root.dark ? #555555 : #e2d9d4; }
                Text { text: "已有规则"; color: root.dark ? #dddddd : #333333; font-size: 15px; }
                if root.filters.length == 0: Text { text: "暂无过滤规则"; color: root.dark ? #aaaaaa : #888888; font-size: 13px; }
                for rule in root.filters: Rectangle { height: 58px; HorizontalLayout { padding-top: 7px; padding-bottom: 7px; spacing: 8px; VerticalLayout { horizontal-stretch: 1; Text { text: "过滤：" + rule.search; color: root.dark ? #dddddd : #333333; font-size: 12px; overflow: elide; } Text { text: "替换：" + (rule.replacement == "" ? "删除" : rule.replacement); color: root.dark ? #aaaaaa : #777777; font-size: 11px; overflow: elide; } } Button { text: "删除"; clicked => { root.remove-filter(rule.id); } } } }
            }
        }
        Button { text: "关闭"; width: 84px; clicked => { root.close(); } }
    }
}

export component MainWindow inherits Window {
    title: "阅读";
    width: 1240px;
    height: 800px;
    background: Theme.shell-background;
    in property <int> page: 0;
    in-out property <bool> catalog-open: false;
    in property <string> selected-book-title: "";
    in property <string> selected-book-author: "";
    in property <string> recent-book-title: "";
    in property <string> recent-book-id: "";
    in property <string> selected-chapter-title: "";
    in property <string> chapter-content: "";
    in property <string> status: "";
    in property <string> search-text: "";
    in-out property <string> filter-search: "";
    in-out property <string> filter-replacement: "";
    in property <int> theme: 0;
    in property <int> font: 4;
    in property <int> font-size: 18;
    in property <float> line-spacing: 0.8;
    in property <float> paragraph-spacing: 1.0;
    in property <float> letter-spacing-value: 0.0;
    in property <int> jump-duration: 1000;
    in property <bool> infinite-loading: false;
    in property <int> read-width: 800;
    in-out property <bool> settings-open: false;
    in-out property <bool> filters-open: false;
    in-out property <bool> toolbar-open: true;
    in property <[BookItem]> books;
    in property <[ChapterItem]> chapters;
    in property <[FilterItem]> filters;
    pure callback transfer-to-paths(data-transfer) -> [string];
    callback import-clicked();
    callback files-dropped([string]);
    callback clear-clicked();
    callback search-changed(string);
    callback book-clicked(string);
    callback book-delete(string);
    callback shelf-clicked();
    callback recent-clicked(string);
    callback chapter-clicked(int);
    callback previous-clicked();
    callback next-clicked();
    callback settings-clicked();
    callback filters-clicked();
    callback close-panel();
    callback add-filter(string, string);
    callback remove-filter(int);
    callback save-settings(int, int, int, float, float, int);
    callback save-advanced-settings(float, int, bool);

    if page == 0: Rectangle {
        background: Theme.shell-background;
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: 272px;
                background: Theme.sidebar-background;
                border-width: 1px;
                border-color: #e6e5e2;
                VerticalLayout {
                    padding-top: 34px;
                    padding-left: 28px;
                    padding-right: 28px;
                    padding-bottom: 26px;
                    spacing: 0px;
                    Text { text: "阅读"; color: #30343a; font-size: 24px; font-weight: 700; }
                    Text { text: "本地 TXT 阅读器"; color: #777b81; font-size: 14px; }
                    Rectangle { height: 22px; }
                    LineEdit { height: 38px; text: root.search-text; placeholder-text: "筛选本地书架"; edited(text) => { root.search-changed(text); } }
                    Rectangle { height: 28px; }
                    Text { text: "最近阅读"; color: #666b72; font-size: 14px; font-weight: 600; }
                    Rectangle { height: 40px; border-radius: 5px; border-width: 1px; border-color: root.recent-book-title == "" ? #e4e3e0 : #c9d9ec; background: root.recent-book-title == "" ? #f2f2f0 : #f0f6fc; VerticalLayout { padding-left: 12px; padding-right: 12px; Text { text: root.recent-book-title == "" ? "暂无阅读记录" : root.recent-book-title; color: root.recent-book-title == "" ? #888b90 : #3975b5; font-size: 13px; vertical-alignment: center; overflow: elide; } } TouchArea { clicked => { root.recent-clicked(root.recent-book-id); } } }
                    Rectangle { height: 28px; }
                    Text { text: "本地数据"; color: #666b72; font-size: 14px; font-weight: 600; }
                    Rectangle { height: 10px; }
                    Button { text: "导入 TXT"; width: parent.width; height: 36px; clicked => { root.import-clicked(); } }
                    Rectangle { height: 8px; }
                    Button { text: "清空数据"; width: parent.width; height: 36px; clicked => { root.clear-clicked(); } }
                    Rectangle { vertical-stretch: 1; }
                    Rectangle { height: 1px; background: #e5e4e1; }
                    Rectangle { height: 12px; }
                    Text { text: "纯本地 · SQLite 存储"; color: #858990; font-size: 12px; horizontal-alignment: center; }
                    Text { text: "书籍与阅读进度仅保存在此设备"; color: #989ba0; font-size: 11px; horizontal-alignment: center; }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.shell-background;
                drop := DropArea { can-drop(event) => { root.transfer-to-paths(event.data).length > 0 ? DragAction.copy : DragAction.none } dropped(event) => { root.files-dropped(root.transfer-to-paths(event.data)); return event.proposed-action; } }
                VerticalLayout {
                    padding: 36px;
                    spacing: 18px;
                    HorizontalLayout { height: 30px; Text { text: "我的书架"; color: Theme.text; font-size: 21px; font-weight: 700; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } Text { text: root.status; color: #727982; font-size: 12px; vertical-alignment: center; overflow: elide; } }
                    if root.books.length == 0 && root.search-text == "": Rectangle { vertical-stretch: 1; border-width: 1px; border-color: #d9dadd; border-radius: 8px; background: #fbfbfc; VerticalLayout { alignment: center; spacing: 12px; Text { text: "导入 TXT 开始阅读"; color: Theme.text; font-size: 22px; font-weight: 700; horizontal-alignment: center; } Text { text: "选择本地 TXT 文件，或直接拖拽到书架区域导入。"; color: Theme.muted; font-size: 14px; horizontal-alignment: center; } Rectangle { height: 4px; } Button { text: "导入 TXT"; clicked => { root.import-clicked(); } } } }
                    if root.books.length == 0 && root.search-text != "": Rectangle { vertical-stretch: 1; border-width: 1px; border-color: #d9dadd; border-radius: 8px; background: #fbfbfc; VerticalLayout { alignment: center; spacing: 8px; Text { text: "没有找到匹配的书籍"; color: Theme.text; font-size: 20px; font-weight: 700; horizontal-alignment: center; } Text { text: "请尝试其他书名或作者关键词。"; color: Theme.muted; font-size: 14px; horizontal-alignment: center; } } }
                    if root.books.length > 0: ListView { vertical-stretch: 1; for book in root.books: BookCard { width: parent.width; book: book; open(id) => { root.book-clicked(id); } remove(id) => { root.book-delete(id); } } }
                }
            }
        }
    }

    if page == 1: Rectangle {
        background: theme == 6 ? #202020 : (theme == 4 ? #f5e4e4 : #ede7da);
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 12px;
            if root.toolbar-open: VerticalLayout {
                width: 58px;
                spacing: 0px;
                ReaderTool { label: "目录"; icon: @image-url("icons/catalog.svg"); dark: root.theme == 6; clicked => { root.catalog-open = !root.catalog-open; root.settings-open = false; root.filters-open = false; } }
                ReaderTool { label: "设置"; icon: @image-url("icons/settings.svg"); dark: root.theme == 6; clicked => { root.settings-clicked(); } }
                ReaderTool { label: "过滤"; icon: @image-url("icons/filter.svg"); dark: root.theme == 6; clicked => { root.filters-clicked(); } }
                ReaderTool { label: "书架"; icon: @image-url("icons/shelf.svg"); dark: root.theme == 6; clicked => { root.shelf-clicked(); } }
                Rectangle { vertical-stretch: 1; }
                ReaderTool { label: "顶部"; icon: @image-url("icons/arrow-up.svg"); dark: root.theme == 6; clicked => { reader-scroll.content-y = 0px; } }
                ReaderTool { label: "底部"; icon: @image-url("icons/arrow-down.svg"); dark: root.theme == 6; clicked => { reader-scroll.content-y = reader-scroll.visible-height - reader-scroll.content-height; } }
            }
            Rectangle { horizontal-stretch: 1; }
            Rectangle { horizontal-stretch: 4; max-width: root.read-width * 1px; min-width: 320px; background: theme == 6 ? #202020 : (theme == 4 ? #f5e4e4 : #ede7da); border-width: 1px; border-color: theme == 6 ? #444444 : #d8d8d8; reader-scroll := ScrollView { vertical-stretch: 1; horizontal-stretch: 1; VerticalLayout { width: parent.width; padding-left: 65px; padding-right: 65px; spacing: 12px; Rectangle { height: 64px; } Text { text: root.selected-chapter-title; width: parent.width; color: root.theme == 6 ? #eeeeee : #262626; font-size: (root.font-size + 6) * 1px; font-family: "Microsoft YaHei"; wrap: word-wrap; } Text { text: root.selected-book-author; width: parent.width; color: root.theme == 6 ? #aaaaaa : #8b7d72; font-size: 12px; } Rectangle { height: 8px; } Text { text: root.chapter-content; width: parent.width; color: root.theme == 6 ? #dedede : #262626; font-size: root.font-size * 1px; font-family: root.font == 0 ? "SimSun" : (root.font == 1 ? "SimHei" : (root.font == 2 ? "KaiTi" : "Microsoft YaHei")); wrap: word-wrap; } Rectangle { height: 64px; } } } }
            Rectangle { horizontal-stretch: 1; }
            if root.toolbar-open: VerticalLayout { width: 42px; Rectangle { vertical-stretch: 1; } ReaderTool { width: 42px; label: "上一章"; icon: @image-url("icons/arrow-up.svg"); dark: root.theme == 6; clicked => { root.previous-clicked(); } } ReaderTool { width: 42px; label: "下一章"; icon: @image-url("icons/arrow-down.svg"); dark: root.theme == 6; clicked => { root.next-clicked(); } } }
        }
        if root.catalog-open: Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height; background: rgba(0, 0, 0, 0.08); catalog-backdrop := TouchArea { clicked => { root.catalog-open = false; } } }
        if root.catalog-open: CatalogPanel { x: 74px; y: 0px; width: 320px; height: parent.height; dark: root.theme == 6; chapters: root.chapters; chapter-clicked(i) => { root.chapter-clicked(i); root.catalog-open = false; } close => { root.catalog-open = false; } }
    }

    if page == 1 && settings-open: Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height; background: rgba(0, 0, 0, 0.10); settings-backdrop := TouchArea { clicked => { root.close-panel(); } } }
    if page == 1 && settings-open: SettingsPanel { x: (parent.width - 400px) / 2; y: 0px; width: 400px; height: parent.height; dark: root.theme == 6; theme: root.theme; font: root.font; font-size: root.font-size; line-spacing: root.line-spacing; paragraph-spacing: root.paragraph-spacing; letter-spacing-value: root.letter-spacing-value; jump-duration: root.jump-duration; infinite-loading: root.infinite-loading; read-width: root.read-width; save-settings(t, fsize, rw, line, paragraph, f) => { root.save-settings(t, fsize, rw, line, paragraph, f); } save-advanced-settings(letter, jump, infinite) => { root.save-advanced-settings(letter, jump, infinite); } close => { root.close-panel(); } }

    if page == 1 && filters-open: Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height; background: rgba(0, 0, 0, 0.10); filters-backdrop := TouchArea { clicked => { root.close-panel(); } } }
    if page == 1 && filters-open: FilterPanel { x: (parent.width - 420px) / 2; y: 0px; width: 420px; height: parent.height; dark: root.theme == 6; search <=> root.filter-search; replacement <=> root.filter-replacement; filters: root.filters; add-filter(search, replacement) => { root.add-filter(search, replacement); } remove-filter(id) => { root.remove-filter(id); } close => { root.close-panel(); } }
}
