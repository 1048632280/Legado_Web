{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Legado 本地 TXT 阅读器",
  "version": "1.0.0",
  "identifier": "com.legado.localreader",
  "build": {
    "beforeDevCommand": "pnpm desktop:frontend:dev",
    "devUrl": "http://127.0.0.1:8080",
    "beforeBuildCommand": "pnpm desktop:frontend:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Legado 本地 TXT 阅读器",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'none'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../public/favicon.ico"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "startMenuFolder": "Legado Web",
        "template": "nsis/installer.nsi",
        "installerHooks": "nsis/installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
