{
  "name": "legado-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm web:dev",
    "build": "pnpm web:build",
    "preview": "pnpm web:preview",
    "web:dev": "vite --mode web --host 127.0.0.1",
    "web:build": "pnpm type-check && vite build --mode web",
    "web:preview": "vite preview --mode web --host 127.0.0.1",
    "desktop:frontend:dev": "vite --mode desktop --host 127.0.0.1",
    "desktop:frontend:build": "pnpm type-check && vite build --mode desktop",
    "desktop:dev": "tauri dev",
    "desktop:build": "pnpm desktop:build:all",
    "desktop:build:all": "pwsh -NoProfile -File scripts/build-desktop.ps1 -Target All",
    "desktop:build:online": "pwsh -NoProfile -File scripts/build-desktop.ps1 -Target OnlineInstaller",
    "desktop:build:offline": "pwsh -NoProfile -File scripts/build-desktop.ps1 -Target OfflineInstaller",
    "desktop:build:portable": "pwsh -NoProfile -File scripts/build-desktop.ps1 -Target Portable",
    "desktop:build:portable-offline": "pwsh -NoProfile -File scripts/build-desktop.ps1 -Target PortableOffline",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint .",
    "verify": "pnpm type-check && pnpm lint && vite build --mode web",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@element-plus/icons-svg": "^2.3.1",
    "@element-plus/icons-vue": "^2.3.1",
    "@tauri-apps/api": "^2.11.1",
    "@vueuse/shared": "^11.1.0",
    "element-plus": "2.8.5",
    "pinia": "^2.2.4",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5",
    "vue3-virtual-scroll-list": "^0.2.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^20.16.11",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/eslint-config-prettier": "^10.0.0",
    "@vue/eslint-config-typescript": "^14.0.1",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.12.0",
    "eslint-plugin-vue": "^9.29.0",
    "prettier": "^3.3.3",
    "sass-embedded": "^1.83.1",
    "typescript": "~5.5.4",
    "unplugin-auto-import": "^0.18.3",
    "unplugin-vue-components": "^0.27.4",
    "vite": "^5.4.8",
    "vue-tsc": "^2.1.6"
  }
}
